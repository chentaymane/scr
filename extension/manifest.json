{
  "manifest_version": 3,
  "name": "Social Contact Extractor",
  "version": "1.1.0",
  "description": "Deep-extract emails, phones, bios, websites, link-in-bio contacts, and social handles from post interactors (likes and comments) across 8 social platforms. For personal privacy auditing only.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://*.instagram.com/*",
    "https://*.pinterest.com/*",
    "https://*.quora.com/*",
    "https://*.twitter.com/*",
    "https://*.x.com/*",
    "https://*.tiktok.com/*",
    "https://*.reddit.com/*",
    "https://*.linkedin.com/*",
    "https://linktr.ee/*",
    "https://*.linktr.ee/*",
    "https://allmylinks.com/*",
    "https://beacons.ai/*",
    "https://about.me/*",
    "https://carrd.co/*",
    "https://bio.link/*",
    "https://hey.link/*",
    "https://lnk.bio/*",
    "https://taplink.cc/*",
    "https://withkoji.com/*",
    "https://stan.store/*",
    "https://komi.io/*",
    "https://linkpop.com/*",
    "https://shorturl.com/*",
    "https://lnkfi.re/*",
    "https://snipfeed.co/*",
    "https://directme.link/*",
    "https://bento.me/*",
    "https://popl.co/*",
    "https://interact.me/*",
    "https://link.bio/*",
    "https://heyyo.io/*",
    "https://mylink.page/*",
    "https://flowpage.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Social Contact Extractor",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.facebook.com/*"],
      "js": ["platforms/utils.js", "platforms/facebook.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.instagram.com/*"],
      "js": ["platforms/utils.js", "platforms/instagram.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.twitter.com/*", "https://*.x.com/*"],
      "js": ["platforms/utils.js", "platforms/twitter.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.pinterest.com/*"],
      "js": ["platforms/utils.js", "platforms/pinterest.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.quora.com/*"],
      "js": ["platforms/utils.js", "platforms/quora.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.tiktok.com/*"],
      "js": ["platforms/utils.js", "platforms/tiktok.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.reddit.com/*"],
      "js": ["platforms/utils.js", "platforms/reddit.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.linkedin.com/*"],
      "js": ["platforms/utils.js", "platforms/linkedin.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
