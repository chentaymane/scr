{
  "manifest_version": 3,
  "name": "Social Contact Extractor",
  "version": "1.0.0",
  "description": "Extract emails and phone numbers from post interactors (likes and comments) on social platforms. For personal privacy auditing only.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://*.instagram.com/*",
    "https://*.pinterest.com/*",
    "https://*.quora.com/*",
    "https://*.twitter.com/*",
    "https://*.x.com/*",
    "https://*.tiktok.com/*",
    "https://*.reddit.com/*",
    "https://*.linkedin.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Social Contact Extractor",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.facebook.com/*"],
      "js": ["platforms/utils.js", "platforms/facebook.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.instagram.com/*"],
      "js": ["platforms/utils.js", "platforms/instagram.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.twitter.com/*", "https://*.x.com/*"],
      "js": ["platforms/utils.js", "platforms/twitter.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.pinterest.com/*"],
      "js": ["platforms/utils.js", "platforms/pinterest.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.quora.com/*"],
      "js": ["platforms/utils.js", "platforms/quora.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.tiktok.com/*"],
      "js": ["platforms/utils.js", "platforms/tiktok.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.reddit.com/*"],
      "js": ["platforms/utils.js", "platforms/reddit.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.linkedin.com/*"],
      "js": ["platforms/utils.js", "platforms/linkedin.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
